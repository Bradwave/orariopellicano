  "subjectRules": [
    {
      "name": "Matematica",
      "pattern": "matematica|^\\s*mat\\b",
      "color": "#3b82f6",
      "bg": "rgba(59, 130, 246, 0.14)",
      "border": "#60a5fa"
    },
    {
      "name": "Fisica",
      "pattern": "fisica|^\\s*fis\\b",
      "color": "#10b981",
      "bg": "rgba(16, 185, 129, 0.14)",
      "border": "#34d399"
    },
    {
      "name": "Italiano / Lettere",
      "pattern": "italiano|lettere|^\\s*ita\\b",
      "color": "#e11d48",
      "bg": "rgba(225, 29, 72, 0.14)",
      "border": "#f43f5e"
    },
    {
      "name": "Latino / Greco",
      "pattern": "latino|greco",
      "color": "#7c3aed",
      "bg": "rgba(124, 58, 237, 0.14)",
      "border": "#8b5cf6"
    },
    {
      "name": "Inglese / Lingua",
      "pattern": "inglese|straniera|lingua",
      "color": "#ea580c",
      "bg": "rgba(234, 88, 12, 0.14)",
      "border": "#f97316"
    },
    {
      "name": "Storia / Filosofia",
      "pattern": "storia|filosofia",
